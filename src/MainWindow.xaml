<Window
    x:Class="AormsConnect.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AORMS Connect">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="AORMS Connect" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Suite core — sign in once · launch apps · shared projects · DB connector · installer links"
                           Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sign in" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SessionStatusText" TextWrapping="Wrap"
                               Text="Not signed in — activate with a licence key (hub syncToken). Suite apps import session.json (C2)."/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="LicenseKeyBox" Width="280" PlaceholderText="License key (HLP-…)"
                                 Header="Activate"/>
                        <Button Content="Activate" Click="Activate_Click" VerticalAlignment="Bottom"/>
                        <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock x:Name="LogText" Opacity="0.7" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="DB connector" FontWeight="SemiBold"/>
                    <TextBlock Text="Local firm.db bind + Flush to hub. Web Ops DB Manager (/ops-db) browses what you publish — it does not edit SQLite."
                               Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock x:Name="DbConnectorStatusText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Enqueue test meta" Click="EnqueueTestMeta_Click"/>
                        <Button Content="Flush to hub" Click="Flush_Click"
                                Background="#FF4F18" Foreground="White"/>
                        <Button Content="Refresh outbox" Click="RefreshOutbox_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="DbConnectorLogText" Opacity="0.75" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Suite apps" FontWeight="SemiBold"/>
                    <TextBlock Text="Open an installed app, or get the installer from aorms.in/downloads (Coming soon until D6)."
                               Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                    <ItemsControl x:Name="SuiteAppsList"/>
                    <Button Content="Open downloads portal" Click="OpenDownloads_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Projects" FontWeight="SemiBold"/>
                    <TextBlock Text="Shared firm catalog — sibling apps read the same project ids via ConnectCatalog."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                    <TextBox x:Name="NewProjectTitleBox" Header="New project title" PlaceholderText="Project title"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add local" Click="AddProject_Click"/>
                        <Button Content="Reload" Click="ReloadProjects_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ProjectListText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Licence Manager" FontWeight="SemiBold"/>
                    <TextBlock Text="Local seat status for this machine. Operator console (issue / revoke / devices) stays on admin.aorms.in — not Stripe metering."
                               Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock x:Name="LicenceStatusText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open License Manager" Click="OpenLicenseManager_Click"/>
                        <Button Content="Copy install id" Click="CopyInstallId_Click"/>
                        <Button Content="Export session.json" Click="ExportSession_Click"/>
                        <Button Content="Clear local licence" Click="ClearLocalLicence_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="6"
                       Text="Package in.aorms.connect · Canon: docs/esti/AORMS-CONNECT.md · Do not fork bbs_engine."
                       Opacity="0.6" TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</Window>
